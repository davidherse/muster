<div class="flex items-center justify-between mb-6">
  <h1 class="font-semibold text-3xl tracking-tight">Price Book</h1>
  <%= link_to "＋ Add item", new_price_book_item_path, class: ui_button %>
</div>

<p class="text-muted-foreground mb-4 text-sm">Average unit rates from your historical jobs. Muster grounds its pricing in these — keep them current.</p>

<%= form_with url: price_book_items_path, method: :get, class: "mb-6" do |form| %>
  <%= form.text_field :q, value: @query, placeholder: "Search descriptions or categories…", class: "#{ui_input} md:w-96" %>
<% end %>

<div class="<%= ui_card %> overflow-hidden">
  <table class="<%= ui_table %>">
    <thead class="bg-muted/50">
      <tr class="<%= ui_table_header_row %>">
        <th class="<%= ui_table_head %> px-5">Category</th>
        <th class="<%= ui_table_head %> w-1/2">Description</th>
        <th class="<%= ui_table_head %>">Type</th>
        <th class="<%= ui_table_head %>">UOM</th>
        <th class="<%= ui_table_head %> text-right">Unit Cost</th>
        <th class="<%= ui_table_head %> px-5"></th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr class="<%= ui_table_row %>">
          <td class="<%= ui_table_cell %> px-5 text-muted-foreground"><%= item.category %></td>
          <td class="<%= ui_table_cell %> text-foreground"><%= item.description %></td>
          <td class="<%= ui_table_cell %> text-muted-foreground"><%= item.item_type %></td>
          <td class="<%= ui_table_cell %> text-muted-foreground"><%= item.uom %></td>
          <td class="<%= ui_table_cell %> text-foreground text-right"><%= number_to_currency(item.unit_cost, unit: "$") %></td>
          <td class="<%= ui_table_cell %> px-5 text-right">
            <%= link_to "Edit", edit_price_book_item_path(item), class: "text-primary underline-offset-4 hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @items.size == 200 %>
    <p class="px-5 py-3 text-xs text-muted-foreground border-t border-border">Showing first 200 matches — refine your search to see more.</p>
  <% end %>
</div>
