<%= form_with model: item, class: "contents" do |form| %>
  <% if item.errors.any? %>
    <div class="<%= ui_alert(variant: :destructive) %> mb-5">
      <ul class="list-disc list-inside">
        <% item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="<%= ui_card %> p-6 space-y-5">
    <div class="grid gap-2">
      <%= form.label :category, class: ui_label %>
      <%= form.text_field :category, required: true, class: ui_input %>
    </div>
    <div class="grid gap-2">
      <%= form.label :description, class: ui_label %>
      <%= form.text_area :description, rows: 2, required: true, class: ui_textarea %>
    </div>
    <div class="grid grid-cols-3 gap-4">
      <div class="grid gap-2">
        <%= form.label :item_type, "Type", class: ui_label %>
        <%= form.select :item_type, EstimateLineItem::ITEM_TYPES, { include_blank: true }, { class: ui_select } %>
      </div>
      <div class="grid gap-2">
        <%= form.label :uom, "UOM", class: ui_label %>
        <%= form.text_field :uom, placeholder: "m2, ea, hour…", class: ui_input %>
      </div>
      <div class="grid gap-2">
        <%= form.label :unit_cost, "Unit cost (ex. GST)", class: ui_label %>
        <%= form.number_field :unit_cost, step: 0.01, min: 0, required: true, class: ui_input %>
      </div>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-3">
    <%= form.submit class: ui_button %>
    <%= link_to "Cancel", price_book_items_path, class: ui_button(variant: :ghost) %>
    <% unless item.new_record? %>
      <%= button_to "Delete", price_book_item_path(item), method: :delete, data: { turbo_confirm: "Remove this item?" }, class: "#{ui_button(variant: :destructive, size: :sm)} ml-auto" %>
    <% end %>
  </div>
<% end %>
