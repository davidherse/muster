<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Muster" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Muster">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background min-h-screen">
    <% if authenticated? && !content_for?(:full_bleed) %>
      <div class="flex min-h-screen" data-controller="sidebar">
        <aside class="w-56 shrink-0 border-r border-border bg-card flex flex-col fixed inset-y-0 transition-all" data-sidebar-target="aside">
          <div class="px-3 py-5 border-b border-border flex items-center justify-between gap-2" data-sidebar-target="header">
            <%= link_to root_path, class: "flex items-center shrink-0", data: { sidebar_target: "label" } do %>
              <%= image_tag "muster_mark.svg", alt: "Muster", class: "h-8 w-auto" %>
            <% end %>
            <button type="button" data-action="sidebar#toggle" class="text-muted-foreground hover:text-foreground p-1.5 rounded-md hover:bg-accent transition-colors shrink-0" title="Toggle sidebar">
              <%= ui_icon("panel-left") %>
            </button>
          </div>
          <nav class="flex-1 px-2.5 py-4 space-y-1 text-sm font-medium">
            <% nav_items = [ [ "Estimates", estimates_path, "file-text" ], [ "Training", training_documents_path, "graduation-cap" ] ] %>
            <% nav_items << [ "Price Book", price_book_items_path, "book-open" ] if Current.user.admin? %>
            <% nav_items.each do |label, path, icon| %>
              <% active = request.path.start_with?(path) %>
              <%= link_to path, title: label, data: { sidebar_target: "item" }, class: "flex items-center gap-3 px-2.5 py-2 rounded-md transition-colors #{active ? 'bg-secondary text-secondary-foreground' : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'}" do %>
                <span class="shrink-0"><%= ui_icon(icon) %></span>
                <span data-sidebar-target="label" class="truncate"><%= label %></span>
              <% end %>
            <% end %>
          </nav>
          <div class="px-2.5 py-3 border-t border-border">
            <details class="relative" data-controller="dropdown">
              <summary class="flex items-center gap-3 px-1.5 py-2 rounded-md cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-accent transition-colors" data-sidebar-target="item">
                <span class="<%= ui_avatar %>">
                  <span class="<%= ui_avatar_fallback %>"><%= ui_initials(Current.user.name) %></span>
                </span>
                <span class="min-w-0" data-sidebar-target="label">
                  <span class="block text-sm font-medium text-foreground truncate"><%= Current.user.name %></span>
                  <span class="block text-xs text-muted-foreground truncate"><%= Current.user.email_address %></span>
                </span>
              </summary>
              <div class="<%= ui_dropdown_content %> absolute bottom-full left-0 mb-2 w-max min-w-[10rem]">
                <%= button_to session_path, method: :delete, class: ui_dropdown_item do %>
                  <%= ui_icon("log-out") %> Sign out
                <% end %>
              </div>
            </details>
          </div>
        </aside>

        <main class="flex-1 ml-56 px-8 py-8 max-w-6xl transition-all" data-sidebar-target="main">
          <% if alert = flash[:alert] %>
            <div class="<%= ui_alert(variant: :destructive) %> mb-5" id="alert"><%= alert %></div>
          <% end %>
          <% if notice = flash[:notice] %>
            <div class="<%= ui_alert %> mb-5" id="notice"><%= notice %></div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main class="container mx-auto mt-10 mb-20 px-5">
        <% if alert = flash[:alert] %>
          <div class="<%= ui_alert(variant: :destructive) %> mb-5" id="alert"><%= alert %></div>
        <% end %>
        <% if notice = flash[:notice] %>
          <div class="<%= ui_alert %> mb-5" id="notice"><%= notice %></div>
        <% end %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
