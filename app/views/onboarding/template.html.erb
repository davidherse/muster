<div class="mx-auto md:w-2/3 w-full">
  <%= render "steps", current: 2 %>

  <% if @proposal %>
    <h1 class="font-semibold text-3xl tracking-tight mb-2">Your estimate template</h1>
    <p class="text-muted-foreground mb-6 text-sm">
      This is how Muster read your estimating style — your sections, in your
      order, broken down the way you break them down. Every estimate will be
      built on this structure. If something's off, add another example and it
      will be re-derived.
    </p>

    <div class="<%= ui_card %> divide-y divide-border overflow-hidden">
      <% @proposal.sections.each_with_index do |section, i| %>
        <div class="px-5 py-4">
          <div class="flex items-baseline gap-3">
            <span class="text-xs font-mono text-muted-foreground w-6 text-right"><%= i + 1 %></span>
            <div>
              <p class="font-medium text-foreground"><%= section["name"] %></p>
              <% if section["hint"].present? %>
                <p class="text-sm text-muted-foreground"><%= section["hint"] %></p>
              <% end %>
              <% if Array(section["typical_items"]).any? %>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  <% section["typical_items"].each do |item| %>
                    <span class="<%= ui_badge(variant: :outline) %>"><%= item %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <%= button_to onboarding_agree_path, class: ui_button do %>
        <%= ui_icon("check") %> Looks right — use this template
      <% end %>
      <%= link_to "Add another example", onboarding_path, class: ui_button(variant: :outline) %>
      <%= button_to "Skip for now", onboarding_skip_path, class: ui_button(variant: :ghost) %>
    </div>

  <% elsif @documents.where(status: %w[pending processing completed]).any? %>
    <h1 class="font-semibold text-3xl tracking-tight mb-2">Reading your estimates…</h1>
    <p class="text-muted-foreground mb-6 text-sm">
      Muster is breaking your examples into line items and deriving your
      estimate template. This usually takes a couple of minutes — this page
      will update by itself.
    </p>
    <div class="<%= ui_card %> p-6" data-controller="poll" data-poll-url-value="<%= onboarding_status_path %>">
      <div class="h-2 w-full rounded-full bg-secondary overflow-hidden">
        <div data-poll-target="bar" class="h-full rounded-full bg-primary transition-all" style="width: 40%"></div>
      </div>
      <p data-poll-target="note" class="mt-3 text-sm text-muted-foreground">Working…</p>
    </div>
    <div class="mt-6">
      <%= link_to "Back to uploads", onboarding_path, class: ui_button(variant: :ghost) %>
    </div>

  <% else %>
    <h1 class="font-semibold text-3xl tracking-tight mb-2">No examples yet</h1>
    <p class="text-muted-foreground mb-6 text-sm">Upload at least one past estimate and Muster will derive your template from it.</p>
    <div class="flex items-center gap-3">
      <%= link_to "Upload an example", onboarding_path, class: ui_button %>
      <%= button_to "Skip for now", onboarding_skip_path, class: ui_button(variant: :ghost) %>
    </div>
  <% end %>
</div>
