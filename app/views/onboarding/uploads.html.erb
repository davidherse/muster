<div class="mx-auto md:w-2/3 w-full">
  <%= render "steps", current: 1 %>

  <h1 class="font-semibold text-3xl tracking-tight mb-2">Show Muster how you estimate</h1>
  <p class="text-muted-foreground mb-6 text-sm">
    Upload a few past estimates — spreadsheets or CSV exports work best. Muster
    learns two things from them: how you structure an estimate (your sections,
    your line items, your level of breakdown) and your usual price ranges.
    Each upload is broken down into your price book for later.
  </p>

  <%= form_with model: @document, url: onboarding_uploads_path, class: "contents" do |form| %>
    <% if @document.errors.any? %>
      <div class="<%= ui_alert(variant: :destructive) %> mb-5">
        <ul class="list-disc list-inside">
          <% @document.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="<%= ui_card %> p-6 space-y-5">
      <div class="grid gap-2">
        <%= form.label :name, "Project name", class: ui_label %>
        <%= form.text_field :name, required: true, placeholder: "e.g. 12 Smith St (2024)", class: ui_input %>
      </div>
      <div class="grid gap-2">
        <%= form.label :priced_on, "When was it priced?", class: ui_label %>
        <%= form.date_field :priced_on, required: true, max: Date.current, class: "#{ui_input} md:w-64" %>
        <p class="text-xs text-muted-foreground">Old prices are indexed to today's dollars from this date.</p>
      </div>
      <div class="grid gap-2">
        <%= form.label :description, "What was the job? (optional)", class: ui_label %>
        <%= form.text_area :description, rows: 2, placeholder: "e.g. Raise and build-under of a pre-war Queenslander; full repaint; retaining by others…", class: ui_textarea %>
      </div>
      <div class="grid gap-2">
        <%= form.label :files, "Estimate files (XLSX, CSV, or PDF)", class: ui_label %>
        <%= form.file_field :files, multiple: true, required: true, accept: "application/pdf,.xlsx,.xls,.csv", class: "block w-full text-sm text-muted-foreground file:mr-4 file:rounded-md file:border-0 file:bg-secondary file:px-4 file:py-2 file:text-secondary-foreground file:font-medium file:cursor-pointer hover:file:bg-secondary/80" %>
      </div>
      <%= form.submit "Add this estimate", class: ui_button(variant: :secondary) %>
    </div>
  <% end %>

  <% if @documents.any? %>
    <div class="<%= ui_card %> divide-y divide-border overflow-hidden mt-6">
      <% @documents.each do |doc| %>
        <div class="flex items-center justify-between px-5 py-3">
          <div>
            <p class="font-medium text-foreground"><%= doc.name %></p>
            <p class="text-xs text-muted-foreground"><%= doc.files.map { |f| f.filename }.join(", ") %></p>
          </div>
          <% variants = { "pending" => ui_badge(variant: :outline), "processing" => ui_badge(variant: :secondary),
                          "completed" => ui_badge(variant: :success), "failed" => ui_badge(variant: :destructive) } %>
          <span class="<%= variants[doc.status] %>"><%= doc.status.capitalize %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-6 flex items-center gap-3">
    <%= link_to onboarding_template_path, class: "#{ui_button} #{'pointer-events-none opacity-50' if @documents.none?}" do %>
      Continue <%= ui_icon("chevron-right") %>
    <% end %>
    <%= button_to "Skip for now", onboarding_skip_path, class: ui_button(variant: :ghost) %>
  </div>
  <p class="mt-3 text-xs text-muted-foreground">Uploads keep processing in the background — you can continue as soon as you've added your examples.</p>
</div>
