<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-semibold text-3xl tracking-tight mb-2">Upload a past estimate</h1>
  <p class="text-muted-foreground mb-6 text-sm">Answer the questions as they applied to <em>that</em> job — the context is what makes your rates reusable.</p>

  <%= form_with model: @document, url: training_documents_path, class: "contents" do |form| %>
    <% if @document.errors.any? %>
      <div class="<%= ui_alert(variant: :destructive) %> mb-5">
        <ul class="list-disc list-inside">
          <% @document.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="<%= ui_card %> p-6 space-y-6">
      <div class="grid gap-2">
        <%= form.label :name, "Project name", class: ui_label %>
        <%= form.text_field :name, required: true, placeholder: "e.g. 12 Smith St (2024)", class: ui_input %>
      </div>
      <div class="grid gap-2">
        <%= form.label :priced_on, "When was this estimate priced?", class: ui_label %>
        <%= form.date_field :priced_on, required: true, max: Date.current, class: "#{ui_input} md:w-64" %>
        <p class="text-xs text-muted-foreground">Rates are escalated to today's dollars from this date (Brisbane construction cost movement).</p>
      </div>

      <div class="grid gap-2">
        <%= form.label :description, "Describe the job in your own words", class: ui_label %>
        <p class="text-sm text-muted-foreground">Scope, what was retained vs new, anything unusual about the site or spec. The more you tell us, the better we learn how you price — this description drives the calibration estimate we run against your plans.</p>
        <%= form.text_area :description, rows: 4, placeholder: "e.g. Raise and build-under of a pre-war Queenslander on a steep block; full repaint incl. retained VJ; new pool; retaining by others…", class: ui_textarea %>
      </div>
      <div class="grid gap-2">
        <%= form.label :files, "Estimate documents (PDF, XLSX, or CSV)", class: ui_label %>
        <%= form.file_field :files, multiple: true, required: true, accept: "application/pdf,.xlsx,.xls,.csv", class: "block w-full text-sm text-muted-foreground file:mr-4 file:rounded-md file:border-0 file:bg-secondary file:px-4 file:py-2 file:text-secondary-foreground file:font-medium file:cursor-pointer hover:file:bg-secondary/80" %>
        <p class="text-xs text-muted-foreground">Include the plans (PDF) alongside the estimate and Muster runs a calibration check against them.</p>
      </div>

      <%= render "shared/questionnaire_fields", answers: @document.questionnaire, param_root: "training_document" %>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <%= form.submit "Start training", class: ui_button %>
      <%= link_to "Cancel", training_documents_path, class: ui_button(variant: :ghost) %>
    </div>
  <% end %>
</div>
