<div class="flex items-center justify-between mb-6">
  <h1 class="font-semibold text-3xl tracking-tight">Training</h1>
  <%= link_to "＋ Upload an estimate", new_training_document_path, class: ui_button %>
</div>

<p class="text-muted-foreground mb-6 text-sm md:w-2/3">
  Teach Muster your pricing. Upload a few of your past estimates (PDF or
  spreadsheet) and answer the same questions you'd answer for a new job — your
  rates become a personal price book the estimator prefers over the shared one,
  with the context of what your "high-end" or "sloped block" actually costs.
</p>

<% if @documents.none? %>
  <div class="<%= ui_card %> p-10 text-center text-muted-foreground">
    No training documents yet.
  </div>
<% else %>
  <div class="<%= ui_card %> divide-y divide-border overflow-hidden">
    <% @documents.each do |doc| %>
      <div class="flex items-center justify-between px-5 py-4">
        <div>
          <p class="font-semibold text-foreground"><%= doc.name %></p>
          <p class="text-sm text-muted-foreground">
            <%= doc.files.map { |f| f.filename }.join(", ") %>
            <% if doc.completed? %> · <%= doc.extraction["item_count"] %> rates ingested<% end %>
            <% if doc.failed? %> · <span class="text-destructive"><%= doc.error_message.to_s.truncate(80) %></span><% end %>
          </p>
        </div>
        <div class="flex items-center gap-3">
          <% variants = { "pending" => ui_badge(variant: :outline), "processing" => ui_badge(variant: :secondary),
                          "completed" => ui_badge(variant: :success), "failed" => ui_badge(variant: :destructive) } %>
          <span class="<%= variants[doc.status] %>"><%= doc.status.capitalize %></span>
          <%= button_to "Remove", training_document_path(doc), method: :delete,
              data: { turbo_confirm: "Remove this document and its rates?" },
              class: ui_button(variant: :ghost, size: :sm) %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
