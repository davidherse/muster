<%= form_with model: template, url: template_path(template), method: :patch, scope: :template, class: "contents" do |form| %>
  <% if template.errors.any? %>
    <div class="<%= ui_alert(variant: :destructive) %> mb-5">
      <ul class="list-disc list-inside">
        <% template.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="<%= ui_card %> p-6 space-y-5 mb-6">
    <div class="grid gap-2">
      <%= form.label :name, "Template name", class: ui_label %>
      <%= form.text_field :name, required: true, class: ui_input %>
    </div>
  </div>

  <div data-controller="sections">
    <div data-sections-target="list" class="space-y-3">
      <% template.sections.each do |section| %>
        <%= render "section_row", section: section %>
      <% end %>
    </div>

    <template data-sections-target="blueprint">
      <%= render "section_row", section: { "name" => "", "hint" => "", "typical_items" => [] } %>
    </template>

    <div class="mt-3">
      <button type="button" data-action="sections#add" class="<%= ui_button(variant: :outline, size: :sm) %>">
        <%= ui_icon("plus") %> Add section
      </button>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-3">
    <%= form.submit "Save template", class: ui_button %>
    <%= link_to "Cancel", templates_path, class: ui_button(variant: :ghost) %>
  </div>
<% end %>
