<% content_for :full_bleed, true %>
<% content_for :title, "Muster — AI construction estimating software for builders | Estimate from plans" %>
<% content_for :head do %>
  <meta name="description" content="Muster is a build and renovation estimation assistant for residential builders. Upload your plans and get a trade-broken, costed estimate in minutes — grounded in your own rates, benchmarked on real Australian projects. Now in closed beta.">
<% end %>

<div class="max-w-5xl mx-auto">
  <header class="flex items-center justify-between py-2 mb-14">
    <%= image_tag "muster_logo.svg", alt: "Muster", class: "h-9 w-auto" %>
    <div class="flex items-center gap-3">
      <span class="<%= ui_badge(variant: :secondary) %>">Closed beta</span>
      <% if authenticated? %>
        <%= link_to "Open Muster →", estimates_path, class: ui_button(size: :sm) %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: ui_button(variant: :outline, size: :sm) %>
      <% end %>
    </div>
  </header>

  <section class="text-center max-w-3xl mx-auto mb-16">
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-foreground leading-tight">
      Your build &amp; renovation<br>estimation assistant
    </h1>
    <p class="mt-5 text-lg text-muted-foreground leading-relaxed">
      Upload your plans. Muster reads them like an estimator — takeoffs, trades,
      your own rates — and hands back a costed, trade-broken estimate in minutes,
      ready to download in your format.
    </p>

    <div class="mt-8 max-w-md mx-auto">
      <% if params[:joined] %>
        <div class="<%= ui_alert %> text-left">
          <p class="font-medium text-foreground">You're on the list.</p>
          <p class="text-muted-foreground mt-1">Muster is in closed beta — we're inviting builders in small groups and we'll email you as places open up.</p>
        </div>
      <% else %>
        <%= form_with model: EarlyAccessSignup.new, url: early_access_signups_path, class: "flex gap-2" do |form| %>
          <%= form.email_field :email, required: true, placeholder: "you@yourcompany.com.au", class: "#{ui_input} h-11" %>
          <%= form.submit "Get early access", class: "#{ui_button(size: :lg)} h-11 shrink-0" %>
        <% end %>
        <p class="mt-3 text-xs text-muted-foreground">Closed beta — limited places for Australian residential builders.</p>
      <% end %>
    </div>
  </section>

  <section class="grid md:grid-cols-3 gap-4 mb-16">
    <div class="<%= ui_card %> p-6">
      <div class="text-primary mb-3"><%= ui_icon("file-text", css: "size-6") %></div>
      <h2 class="font-semibold text-foreground mb-1.5">Estimates from plans, not spreadsheets</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">PDF plans in, costed estimate out — quantity takeoffs measured from the drawings, ~40 trade sections itemised with supply, labour and sundries, every quantity showing its working.</p>
    </div>
    <div class="<%= ui_card %> p-6">
      <div class="text-primary mb-3"><%= ui_icon("graduation-cap", css: "size-6") %></div>
      <h2 class="font-semibold text-foreground mb-1.5">Priced the way you price</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">Upload a few past estimates and Muster learns your rates, your PC allowances, and your format — then quotes new work the way your business actually quotes, and exports in your own layout.</p>
    </div>
    <div class="<%= ui_card %> p-6">
      <div class="text-primary mb-3"><%= ui_icon("book-open", css: "size-6") %></div>
      <h2 class="font-semibold text-foreground mb-1.5">Grounded, benchmarked pricing</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">Every rate traces to a price book — your recorded costs, indexed to today's dollars, with published market references as guardrails. Benchmarked against completed Australian projects, not vibes.</p>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-2xl font-semibold tracking-tight text-center mb-8">How it works</h2>
    <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <% [
        [ "1", "Upload plans", "Architectural set, spec schedule, engineering — drop in the PDFs and answer a few quick questions about the job." ],
        [ "2", "Muster estimates", "Plan analysis, quantity takeoffs, trade-by-trade costing at your rates, then an estimator-style review pass — in minutes, not days." ],
        [ "3", "Quote with confidence", "A trade-broken estimate with a low–high range, every assumption visible, exported as CSV in your own estimate format." ]
      ].each do |step, title, body| %>
        <div class="text-center">
          <div class="mx-auto mb-3 size-9 rounded-full bg-primary text-primary-foreground flex items-center justify-center font-semibold"><%= step %></div>
          <h3 class="font-semibold text-foreground mb-1.5"><%= title %></h3>
          <p class="text-sm text-muted-foreground leading-relaxed"><%= body %></p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="<%= ui_card %> p-8 md:p-10 text-center mb-16 bg-primary text-primary-foreground border-primary">
    <h2 class="text-2xl font-semibold tracking-tight mb-2">Construction estimating software that learns your business</h2>
    <p class="opacity-80 max-w-2xl mx-auto leading-relaxed">Whether you call it a renovation cost estimator, quoting software, or takeoff software — Muster is the estimating assistant that reads the plans, prices at your rates, and shows its working. Built for Australian residential builders and remodellers.</p>
    <% unless params[:joined] %>
      <%= form_with model: EarlyAccessSignup.new, url: early_access_signups_path, class: "mt-6 flex gap-2 max-w-md mx-auto" do |form| %>
        <%= form.email_field :email, required: true, placeholder: "you@yourcompany.com.au", class: "#{ui_input} h-11 bg-background text-foreground" %>
        <%= form.submit "Join the beta", class: "#{ui_button(variant: :secondary, size: :lg)} h-11 shrink-0" %>
      <% end %>
    <% end %>
  </section>

  <footer class="border-t border-border py-8 flex items-center justify-between text-sm text-muted-foreground">
    <div class="flex items-center gap-2">
      <%= image_tag "muster_mark.svg", alt: "", class: "h-5 w-auto" %>
      <span>© <%= Date.current.year %> Muster</span>
    </div>
    <span>Build &amp; renovation estimating · Australia</span>
  </footer>
</div>
