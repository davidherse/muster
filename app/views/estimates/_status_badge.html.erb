<% if estimate.needs_answers? %>
  <span class="inline-flex items-center rounded-md border border-transparent bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">Questions for you</span>
<% else %>
  <% variants = {
    "draft" => ui_badge(variant: :outline),
    "processing" => ui_badge(variant: :secondary),
    "completed" => ui_badge(variant: :success),
    "failed" => ui_badge(variant: :destructive)
  } %>
  <span class="<%= variants[estimate.status] %>"><%= estimate.status.capitalize %></span>
<% end %>
