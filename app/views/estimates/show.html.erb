<div class="flex items-start justify-between mb-6">
  <div>
    <h1 class="font-semibold text-3xl tracking-tight"><%= @estimate.name %></h1>
    <p class="text-muted-foreground mt-1">
      <%= @estimate.building_type.presence || "Building type pending" %>
      <% if @estimate.floor_area.present? %> · <%= @estimate.floor_area %> m²<% end %>
      · Created <%= @estimate.created_at.strftime("%-d %b %Y") %>
    </p>
  </div>
  <div class="flex items-center gap-3">
    <%= render "status_badge", estimate: @estimate %>
    <% if @estimate.completed? %>
      <%= link_to "⬇ Download CSV", csv_estimate_path(@estimate), class: ui_button %>
      <% if EstimateTemplate.where("name LIKE ?", "#{Current.user.name} — %").exists? %>
        <%= link_to "⬇ CSV in my format", csv_estimate_path(@estimate, layout: "mine"), class: ui_button(variant: :secondary) %>
      <% end %>
    <% end %>
    <%= button_to "Delete", estimate_path(@estimate), method: :delete,
        data: { turbo_confirm: "Delete this estimate?" },
        class: ui_button(variant: :outline) %>
  </div>
</div>

<% if @estimate.processing? %>
  <div class="<%= ui_card %> p-10 text-center"
       data-controller="poll" data-poll-url-value="<%= status_estimate_path(@estimate) %>">
    <p class="text-lg font-semibold text-foreground mb-2">Generating your estimate…</p>
    <p class="text-muted-foreground mb-6" data-poll-target="note"><%= @estimate.progress_note.presence || "Working…" %></p>
    <div class="w-full max-w-md mx-auto bg-muted rounded-full h-3">
      <div class="bg-primary h-3 rounded-full transition-all" data-poll-target="bar" style="width: <%= [ @estimate.progress.to_i, 3 ].max %>%"></div>
    </div>
    <p class="text-xs text-muted-foreground mt-4">This page updates automatically. Reading plans and costing ~40 sections takes a few minutes.</p>
  </div>

<% elsif @estimate.failed? %>
  <div class="<%= ui_alert(variant: :destructive) %> p-8">
    <p class="text-lg font-semibold mb-2">Estimate generation failed</p>
    <p class="mb-6"><%= @estimate.error_message %></p>
    <div class="flex items-center gap-4">
      <%= button_to "Try again", regenerate_estimate_path(@estimate, resume: true), method: :post, class: ui_button(variant: :destructive) %>
      <% if @estimate.costed_sections.any? %>
        <span class="text-sm">Picks up from where it stopped (<%= @estimate.costed_sections.size %> sections already costed).</span>
      <% end %>
    </div>
  </div>

<% elsif @estimate.completed? %>
  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="<%= ui_card %> p-5">
      <p class="text-sm text-muted-foreground">Low estimate</p>
      <p class="text-2xl font-bold text-foreground"><%= number_to_currency(@estimate.total_low, unit: "$", precision: 0) %></p>
    </div>
    <div class="rounded-xl bg-primary p-5 text-primary-foreground shadow-sm">
      <p class="text-sm opacity-80">Estimate (ex. GST)</p>
      <p class="text-2xl font-bold"><%= number_to_currency(@estimate.total, unit: "$", precision: 0) %></p>
    </div>
    <div class="<%= ui_card %> p-5">
      <p class="text-sm text-muted-foreground">High estimate</p>
      <p class="text-2xl font-bold text-foreground"><%= number_to_currency(@estimate.total_high, unit: "$", precision: 0) %></p>
    </div>
  </div>

  <% if @estimate.plan_summary.present? %>
    <details class="<%= ui_card %> p-5 mb-8">
      <summary class="font-semibold text-foreground cursor-pointer">Scope of works (from plan analysis)</summary>
      <p class="mt-3 text-muted-foreground whitespace-pre-line"><%= @estimate.plan_summary["scope_summary"] %></p>
    </details>
  <% end %>

  <% @estimate.sections.includes(:line_items).each_with_index do |section, s_idx| %>
    <div class="<%= ui_card %> mb-4 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 bg-muted/50 border-b border-border">
        <h2 class="font-semibold text-foreground"><%= s_idx + 1 %>. <%= section.name %></h2>
        <span class="font-semibold text-foreground"><%= number_to_currency(section.subtotal, unit: "$", precision: 2) %></span>
      </div>
      <table class="<%= ui_table %>">
        <thead>
          <tr class="<%= ui_table_header_row %>">
            <th class="<%= ui_table_head %> px-5 w-1/2">Description</th>
            <th class="<%= ui_table_head %>">Type</th>
            <th class="<%= ui_table_head %>">UOM</th>
            <th class="<%= ui_table_head %> text-right">Qty</th>
            <th class="<%= ui_table_head %> text-right">Unit</th>
            <th class="<%= ui_table_head %> px-5 text-right">Total</th>
          </tr>
        </thead>
        <tbody>
          <% section.line_items.each do |item| %>
            <tr class="<%= ui_table_row %>">
              <td class="<%= ui_table_cell %> px-5 text-foreground">
                <%= item.description %>
                <% if item.assumptions.present? %>
                  <p class="text-xs text-muted-foreground mt-0.5"><%= item.assumptions %></p>
                <% end %>
              </td>
              <td class="<%= ui_table_cell %> text-muted-foreground"><%= item.item_type %></td>
              <td class="<%= ui_table_cell %> text-muted-foreground"><%= item.uom %></td>
              <td class="<%= ui_table_cell %> text-muted-foreground text-right"><%= item.quantity&.to_f %></td>
              <td class="<%= ui_table_cell %> text-muted-foreground text-right"><%= number_to_currency(item.unit_cost, unit: "$") %></td>
              <td class="<%= ui_table_cell %> px-5 text-foreground text-right font-medium"><%= number_to_currency(item.total, unit: "$") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="flex justify-end mt-6">
    <%= button_to "Regenerate estimate", regenerate_estimate_path(@estimate), method: :post,
        data: { turbo_confirm: "This will replace the current line items. Continue?" },
        class: ui_button(variant: :ghost, size: :sm) %>
  </div>

<% else %>
  <div class="<%= ui_card %> p-8 text-center">
    <p class="text-muted-foreground mb-4">This estimate hasn't been generated yet.</p>
    <%= button_to "Generate now", regenerate_estimate_path(@estimate), method: :post, class: ui_button %>
  </div>
<% end %>
