<div class="flex items-center justify-between mb-8">
  <h1 class="font-semibold text-3xl tracking-tight">Estimates</h1>
  <%= link_to "＋ New estimate", new_estimate_path, class: ui_button %>
</div>

<% if @estimates.none? %>
  <div class="<%= ui_card %> p-12 text-center text-muted-foreground">
    <p class="text-lg mb-2 text-foreground font-medium">No estimates yet.</p>
    <p>Upload a PDF plan and Muster will build a costed estimate for you.</p>
    <%= link_to "Create your first estimate", new_estimate_path, class: "#{ui_button} mt-6" %>
  </div>
<% else %>
  <div class="<%= ui_card %> divide-y divide-border overflow-hidden">
    <% @estimates.each do |estimate| %>
      <%= link_to estimate_path(estimate), class: "flex items-center justify-between px-5 py-4 hover:bg-muted/50 transition-colors" do %>
        <div>
          <p class="font-semibold text-foreground"><%= estimate.name %></p>
          <p class="text-sm text-muted-foreground">
            <%= estimate.building_type.presence || "—" %> · <%= estimate.created_at.strftime("%-d %b %Y") %>
          </p>
        </div>
        <div class="flex items-center gap-4">
          <% if estimate.completed? && estimate.total %>
            <span class="font-semibold text-foreground"><%= number_to_currency(estimate.total, unit: "$", precision: 0) %></span>
          <% end %>
          <%= render "status_badge", estimate: estimate %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
