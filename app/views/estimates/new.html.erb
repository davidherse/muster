<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-semibold text-3xl tracking-tight mb-6">New estimate</h1>

  <%= form_with model: @estimate, class: "contents" do |form| %>
    <% if @estimate.errors.any? %>
      <div class="<%= ui_alert(variant: :destructive) %> mb-5" id="error_explanation">
        <ul class="list-disc list-inside">
          <% @estimate.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="<%= ui_card %> p-6 space-y-6">
      <div class="grid gap-2">
        <%= form.label :name, "Project name", class: ui_label %>
        <%= form.text_field :name, required: true, placeholder: "e.g. 12 Smith St Renovation", class: ui_input %>
      </div>

      <div class="grid gap-2">
        <%= form.label :plans, "Plans & specifications (PDF)", class: ui_label %>
        <%= form.file_field :plans, accept: "application/pdf", multiple: true, required: true, class: "block w-full text-sm text-muted-foreground file:mr-4 file:rounded-md file:border-0 file:bg-secondary file:px-4 file:py-2 file:text-secondary-foreground file:font-medium file:cursor-pointer hover:file:bg-secondary/80" %>
        <p class="text-xs text-muted-foreground">Select multiple PDFs — architectural plans plus any specification schedule, engineering set, or soil report. Up to 50 MB each.</p>
      </div>

      <div class="grid gap-2">
        <%= form.label :prompt, "Additional information", class: ui_label %>
        <%= form.text_area :prompt, rows: 5, placeholder: "Anything the plans don't say: finish level, known site issues, inclusions/exclusions, client budget expectations…", class: ui_textarea %>
      </div>

      <%= render "shared/questionnaire_fields", answers: @estimate.questionnaire, param_root: "estimate" %>

      <div class="grid gap-2">
        <%= form.label :estimate_template_id, "Estimate layout", class: ui_label %>
        <%= form.collection_select :estimate_template_id, EstimateTemplate.order(:name), :id, :name, {}, { class: ui_select } %>
        <p class="text-xs text-muted-foreground">Controls the sections your estimate is broken into.</p>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <%= form.submit "Generate estimate", class: ui_button %>
      <%= link_to "Cancel", estimates_path, class: ui_button(variant: :ghost) %>
    </div>
  <% end %>
</div>
