<div class="mx-auto max-w-md w-full mt-16">
  <div class="flex justify-center mb-8">
    <%= link_to root_path, title: "Muster home" do %>
      <%= image_tag "muster_logo.svg", alt: "Muster", class: "h-8 w-auto" %>
    <% end %>
  </div>
  <div class="<%= ui_card %>">
    <div class="<%= ui_card_header %>">
      <h1 class="<%= ui_card_title %> text-xl">Sign in</h1>
      <p class="<%= ui_card_description %>">Enter your email and password to continue.</p>
    </div>
    <div class="<%= ui_card_content %>">
      <%= form_with url: session_url, class: "contents" do |form| %>
        <div class="grid gap-2 mb-4">
          <%= form.label :email_address, "Email", class: ui_label %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address], class: ui_input %>
        </div>

        <div class="grid gap-2 mb-6">
          <%= form.label :password, "Password", class: ui_label %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: ui_input %>
        </div>

        <%= form.submit "Sign in", class: "#{ui_button} w-full" %>

        <div class="mt-4 text-sm text-muted-foreground text-center">
          <%= link_to "Forgot password?", new_password_path, class: "underline underline-offset-4 hover:text-foreground" %>
          <span class="mx-1">·</span>
          <%= link_to "Create account", new_registration_path, class: "underline underline-offset-4 hover:text-foreground" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
